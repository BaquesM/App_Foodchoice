# FoodChoice - Configuration des variables d'environnement

# 1. En local (par défaut, SQLite est utilisé automatiquement sans variable) :
# DATABASE_URL=sqlite:///./foodchoice.db

# 2. En production avec Supabase (PostgreSQL) :
# Remplacez [VOTRE-MOT-DE-PASSE] et [VOTRE-REF-SUPABASE] par vos identifiants Supabase :
# DATABASE_URL=postgresql://postgres:[VOTRE-MOT-DE-PASSE]@db.[VOTRE-REF-SUPABASE].supabase.co:5432/postgres

# Port du serveur web (automatiquement fourni par Render/Railway ou 8080 par défaut) :
PORT=8080
